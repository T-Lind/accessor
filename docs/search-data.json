---
layout: null
---
{%- assign docs = site.pages | where_exp: "p", "p.title" | where_exp: "p", "p.url != '/search-data.json'" -%}
[
{%- for page in docs %}
{"title":{{ page.title | jsonify }},"url":{{ page.url | relative_url | jsonify }},"content":{{ page.content | strip_html | normalize_whitespace | jsonify }},"excerpt":{{ page.content | strip_html | normalize_whitespace | truncatewords: 22 | jsonify }}}{% unless forloop.last %},{% endunless %}
{%- endfor %}
]
